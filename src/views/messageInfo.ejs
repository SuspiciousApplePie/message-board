<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Message</title>
  </head>
  <body>
    <nav>
      <ul>
        <% navBar.forEach((item) => { %>
          <%- include('./navbar/navbar', {navItem: item}); %>
        <% }); %>
      </ul>
    </nav>
    <h1>Sent by: <%= message.username %></h1>
  </body>
  <p><%= message.text %></p>
  <div>Sent in <time datetime=""><%= formatDistanceToNow(message.added, {addSuffix: true}) %></time></div>
</html>

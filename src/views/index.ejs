<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <nav>
      <ul>
        <% navBar.forEach((item) => { %>
          <%- include('./navbar/navbar', {navItem: item}); %>
        <% }); %>
      </ul>
    </nav>
    <h1><%= title %></h1>
    <% messages.forEach((message) => { %>
      <div>
        <%- include('./message/message', {message: message}); %>
      </div>
    <% }); %>
  </body>
</html>
